{
  "//": "On the wording of commit 50311c1, see the message of the commit that added this line.",
  "name": "@shieldfont/font",
  "version": "0.3.5",
  "description": "ShieldFont web fonts, paste-in CSS and browser encoder: the no-build CDN distribution, for learning and for pages with no build step. @shieldfont/react is the recommended route for a site you're shipping. A v0 alpha. This tier ships no screen-reader machinery at all, so that part is yours to build. Accessibility law differs by country and applies to you as the site operator, so check yours first.",
  "type": "module",
  "main": "./shieldfont-encoder.js",
  "exports": {
    ".": {
      "types": "./shieldfont-encoder.d.ts",
      "import": "./shieldfont-encoder.js",
      "default": "./shieldfont-encoder.js"
    },
    "./shieldfont-encoder.js": {
      "types": "./shieldfont-encoder.d.ts",
      "import": "./shieldfont-encoder.js",
      "default": "./shieldfont-encoder.js"
    },
    "./shieldfont.css": "./shieldfont.css",
    "./optik-a.woff2": "./optik-a.woff2",
    "./optik-b.woff2": "./optik-b.woff2",
    "./optik-c.woff2": "./optik-c.woff2",
    "./optik-m.woff2": "./optik-m.woff2",
    "./package.json": "./package.json"
  },
  "files": [
    "shieldfont.css",
    "optik-a.woff2",
    "optik-a-italic.woff2",
    "optik-b.woff2",
    "optik-b-italic.woff2",
    "optik-c.woff2",
    "optik-c-italic.woff2",
    "optik-m.woff2",
    "optik-m-italic.woff2",
    "optik-n.woff2",
    "optik-n-italic.woff2",
    "shieldfont-encoder.js",
    "AGENTS.md",
    "LICENSE",
    "LICENSE-FONTS",
    "NOTICE",
    "README.md",
    "shieldfont-encoder.d.ts"
  ],
  "keywords": [
    "shieldfont",
    "font",
    "cdn",
    "css",
    "anti-scraping",
    "woff2"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git",
    "directory": "packages/font"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "sideEffects": false,
  "types": "./shieldfont-encoder.d.ts"
}
