{
  "name": "@shieldfont/font",
  "version": "0.3.1",
  "description": "ShieldFont web fonts + paste-in CSS + browser encoder: the no-build / CDN distribution. Serve via jsDelivr from npm: https://cdn.jsdelivr.net/npm/@shieldfont/font@0.3.0/shieldfont.css",
  "type": "module",
  "main": "./shieldfont-encoder.js",
  "exports": {
    ".": {
      "types": "./shieldfont-encoder.d.ts",
      "import": "./shieldfont-encoder.js",
      "default": "./shieldfont-encoder.js"
    },
    "./shieldfont-encoder.js": {
      "types": "./shieldfont-encoder.d.ts",
      "import": "./shieldfont-encoder.js",
      "default": "./shieldfont-encoder.js"
    },
    "./shieldfont.css": "./shieldfont.css",
    "./optik-a.woff2": "./optik-a.woff2",
    "./optik-b.woff2": "./optik-b.woff2",
    "./optik-c.woff2": "./optik-c.woff2",
    "./optik-m.woff2": "./optik-m.woff2",
    "./package.json": "./package.json"
  },
  "files": [
    "shieldfont.css",
    "optik-a.woff2",
    "optik-b.woff2",
    "optik-c.woff2",
    "optik-m.woff2",
    "shieldfont-encoder.js",
    "AGENTS.md",
    "LICENSE",
    "LICENSE-FONTS",
    "NOTICE",
    "README.md",
    "shieldfont-encoder.d.ts"
  ],
  "keywords": [
    "shieldfont",
    "font",
    "cdn",
    "css",
    "anti-scraping",
    "woff2"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git",
    "directory": "packages/font"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "sideEffects": false,
  "types": "./shieldfont-encoder.d.ts"
}
