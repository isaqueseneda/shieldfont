{
  "//": "On the wording of commit 50311c1, see the message of the commit that added this line.",
  "name": "@shieldfont/core",
  "version": "0.3.5",
  "description": "Core encoding and decoding for ShieldFont, the AI-scraping-resistant web font. Zero runtime dependencies. A v0 alpha. This package ships none of the screen-reader machinery @shieldfont/react has, so that part is yours to build. Accessibility law differs by country and applies to you as the site operator, so check yours before you encode anything.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./puzzle": {
      "types": "./dist/puzzle.d.ts",
      "import": "./dist/puzzle.js",
      "default": "./dist/puzzle.js"
    },
    "./mappings/alpha": {
      "types": "./dist/mappings/alpha.d.ts",
      "import": "./dist/mappings/alpha.js",
      "default": "./dist/mappings/alpha.js"
    },
    "./mappings/beta": {
      "types": "./dist/mappings/beta.d.ts",
      "import": "./dist/mappings/beta.js",
      "default": "./dist/mappings/beta.js"
    },
    "./mappings/gamma": {
      "types": "./dist/mappings/gamma.d.ts",
      "import": "./dist/mappings/gamma.js",
      "default": "./dist/mappings/gamma.js"
    },
    "./mappings/m15en": {
      "types": "./dist/mappings/m15en.d.ts",
      "import": "./dist/mappings/m15en.js",
      "default": "./dist/mappings/m15en.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "MANIFEST.json",
    "AGENTS.md",
    "LICENSE",
    "LICENSE-FONTS",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-mappings.mjs",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "shieldfont",
    "encoding",
    "anti-scraping"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "sideEffects": false
}
