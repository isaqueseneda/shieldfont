{
  "//": "On the wording of commit 50311c1, see the message of the commit that added this line.",
  "name": "shieldfont-monorepo",
  "version": "0.3.5",
  "private": true,
  "description": "ShieldFont packages — encoding pipeline for the AI-scraping-resistant web font",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/font"
  ],
  "scripts": {
    "build": "npm run -w @shieldfont/core build && npm run -w @shieldfont/react build",
    "test": "npm run -w @shieldfont/core test && npm run -w @shieldfont/react test",
    "generate-inter": "python3 scripts/generate_font.py --base-url https://raw.githubusercontent.com/rsms/inter/v4.1/fonts/ttf/Inter-Regular.ttf --cache-name Inter-Regular.ttf --name 'ShieldFont' --prefix shieldfont",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:hydration": "node scripts/hydration-audit.mjs",
    "test:a11y:nvda": "node scripts/nvda-audit.mjs",
    "test:axe": "node scripts/axe-audit.mjs",
    "test:style": "node scripts/style-audit.mjs"
  },
  "keywords": [
    "font",
    "ai",
    "protection",
    "privacy",
    "scraping",
    "agpl"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "homepage": "https://github.com/isaqueseneda/shieldfont",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.31.0",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
