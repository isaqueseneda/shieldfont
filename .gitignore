# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node (only here for the npm scripts convenience)
node_modules/
package-lock.json
packages/*/dist/
packages/*/node_modules/
examples/*/node_modules/
examples/*/.next/
examples/*/dist/
site/.next/
site/node_modules/

# Editor
.vscode/
.idea/

# Secrets / local config
.env
.env.*
!.env.example

# Generated ShieldFont builds — regenerate with scripts/generate_font.py.
# NOTE: this also incidentally catches the retail Optik masters below (they
# live in the same directory); the explicit never-commit rule further down
# is the one that actually matters for those, not this "regenerate" comment.
public/fonts/*

# Local debug/QA tooling output — never meant to ship, not evidence
public/*.html
public/*.json

# Claude Code session artifacts
.claude/

# benchmark/data/ holds only the specific light, vetted result files and
# scripts copied in from the development repo's v7/v8 research rounds — no
# heavy regeneratable corpora, embeddings, LMs or adapters live here, so
# nothing under it needs an ignore rule. (The old benchmarks/v2-v8 layout
# this block used to manage no longer exists in this repo.)

# Temporary preview server artifacts
shieldfont_test/
site/tsconfig.tsbuildinfo
site/out/

# Root-level Next.js build cache (only site/ should hold Next state)
/.next/

# Retail Optik masters — Playtype proprietary; never commit to a public repo
# (kept on disk for local render/deploy only). site/public/fonts/optik/ is
# where they sit in the separate marketing-site repo; public/fonts/ below
# covers where the same masters and their camouflage/dev-build derivatives
# (optik-regular.*, camo/, BEFORE-*) sit in *this* repo's working tree.
site/public/fonts/optik/
public/fonts/optik-regular.*
public/fonts/camo/
public/fonts/BEFORE-*

# Base fonts generate_font.py downloads and caches (FONT_CACHE_DIR); rebuilt on
# demand from --base-url, so committing them would only pin a stale copy. No
# trailing slash: the directory does not exist until a build runs, and a
# dir-only pattern cannot match a path that is not there yet.
scripts/fonts

# Portable Win64 console build output and local PyInstaller work files
scripts/.portable-build-venv/
.portable-build/
.shieldfont-cache/
dist/

# Local-only working files (never commit) — e.g. RECONCILE-MANIFEST.local.md, TODO-BEFORE-RELEASE.local.md
*.local.md
